function showQRCode(booking) {
  const qrData = JSON.stringify(booking);
  document.getElementById('qrCodeContainer').innerHTML = '';
  
  new QRCode(document.getElementById('qrCodeContainer'), {
    text: qrData,
    width: 280,
    height: 280,
    colorDark: '#0AA1B6',
    colorLight: '#ffffff',
    correctLevel: QRCode.CorrectLevel.H
  });
  
  // عرض تفاصيل الحجز
  const details = `
    <div class="detail-item"><strong>رقم الحجز:</strong><span>${booking.id}</span></div>
    <div class="detail-item"><strong>الاسم:</strong><span>${booking.name}</span></div>
    <div class="detail-item"><strong>التاريخ:</strong><span>${new Date(booking.date).toLocaleDateString('ar-SA')}</span></div>
    <div class="detail-item"><strong>الوقت:</strong><span>${booking.time}</span></div>
    <div class="detail-item"><strong>الخدمة:</strong><span>${booking.service}</span></div>
  `;
  document.getElementById('bookingDetailsList').innerHTML = details;
  
  qrModal.classList.add('active');
  window.currentBooking = booking;
}

