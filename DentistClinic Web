function findResponse(userMessage) {
  userMessage = userMessage.toLowerCase().trim();
  for (let key in responses) {
    const keywords = key.split('|');
    if (keywords.some(k => userMessage.includes(k))) {
      return responses[key];
    }
  }
  return 'شكراً على سؤالك! 😊 للمزيد من المعلومات المفصلة، يرجى التواصل معنا على +966 55 766 4577 أو راسلنا على واتساب.';
}

function addMessage(text, isUser) {
  const msgDiv = document.createElement('div');
  msgDiv.className = `message ${isUser ? 'user' : 'bot'}`;
  
  if (!isUser) {
    msgDiv.innerHTML = `<div class="avatar"><i class="fa-solid fa-robot"></i></div>`;
  }
  
  const textDiv = document.createElement('div');
  textDiv.className = 'message-text';
  textDiv.textContent = text;
  msgDiv.appendChild(textDiv);
  
  chatMessages.appendChild(msgDiv);
  chatMessages.scrollTop = chatMessages.scrollHeight;
}

