<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>د. مجدي نصر | عيادة طب الأسنان</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;900&family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/html5-qrcode@2.3.4/dist/html5-qrcode.min.js"></script>
<style>
:root{
  --primary:#0AA1B6;
  --primary-dark:#067A8C;
  --accent:#5CCFE2;
  --light:#E6F8FB;
  --dark:#0F2940;
  --text:#334155;
  --muted:#64748B;
  --bg:#F7FBFC;
  --white:#ffffff;
  --shadow:0 10px 40px rgba(10,161,182,0.12);
  --shadow-lg:0 20px 60px rgba(10,161,182,0.18);
}
*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{
  font-family:'Tajawal','Cairo',sans-serif;
  color:var(--text);
  background:var(--bg);
  line-height:1.7;
  overflow-x:hidden;
}
.container{max-width:1200px;margin:0 auto;padding:0 20px;}
a{text-decoration:none;color:inherit;}
img{max-width:100%;display:block;}

/* Navbar */
.navbar{
  position:fixed;top:0;left:0;right:0;
  background:rgba(255,255,255,0.95);
  backdrop-filter:blur(10px);
  z-index:1000;
  padding:15px 0;
  transition:all .3s;
  box-shadow:0 2px 20px rgba(0,0,0,0.05);
}
.nav-wrapper{display:flex;justify-content:space-between;align-items:center;}
.logo{font-size:24px;font-weight:900;color:var(--primary);display:flex;align-items:center;gap:10px;}
.logo i{font-size:28px;}
.nav-links{display:flex;gap:30px;list-style:none;}
.nav-links a{font-weight:500;transition:.3s;position:relative;}
.nav-links a:hover{color:var(--primary);}
.nav-links a::after{content:'';position:absolute;bottom:-5px;right:0;width:0;height:2px;background:var(--primary);transition:.3s;}
.nav-links a:hover::after{width:100%;}
.btn-nav{background:var(--primary);color:#fff !important;padding:10px 25px;border-radius:50px;transition:.3s;}
.btn-nav:hover{background:var(--primary-dark);transform:translateY(-2px);}
.menu-toggle{display:none;font-size:24px;background:none;border:none;color:var(--dark);cursor:pointer;}

/* Hero */
.hero{
  padding:140px 0 80px;
  background:linear-gradient(135deg,#E6F8FB 0%,#ffffff 60%,#F0FBFD 100%);
  position:relative;
  overflow:hidden;
}
.hero::before{
  content:'';position:absolute;top:-100px;left:-100px;
  width:400px;height:400px;border-radius:50%;
  background:radial-gradient(circle,rgba(92,207,226,0.3),transparent 70%);
  z-index:0;
}
.hero::after{
  content:'';position:absolute;bottom:-150px;right:-150px;
  width:500px;height:500px;border-radius:50%;
  background:radial-gradient(circle,rgba(10,161,182,0.15),transparent 70%);
  z-index:0;
}
.hero-grid{
  display:grid;grid-template-columns:1fr 1fr;
  gap:60px;align-items:center;position:relative;z-index:1;
}
.hero-content .badge{
  display:inline-flex;align-items:center;gap:8px;
  background:rgba(10,161,182,0.1);color:var(--primary);
  padding:8px 18px;border-radius:50px;font-size:14px;font-weight:600;margin-bottom:20px;
  animation:fadeUp .8s ease;
}
.hero h1{
  font-family:'Cairo',sans-serif;
  font-size:56px;font-weight:900;color:var(--dark);
  line-height:1.2;margin-bottom:15px;
  animation:fadeUp 1s ease;
}
.hero h1 span{color:var(--primary);}
.hero .specialty{
  font-size:20px;color:var(--primary);font-weight:700;margin-bottom:20px;line-height:1.5;
  animation:fadeUp 1.2s ease;
}
.hero p{
  font-size:18px;color:var(--muted);margin-bottom:35px;max-width:520px;
  animation:fadeUp 1.4s ease;
}
.hero-buttons{display:flex;gap:15px;flex-wrap:wrap;animation:fadeUp 1.6s ease;}
.btn-primary{
  background:linear-gradient(135deg,var(--primary),var(--primary-dark));
  color:#fff;padding:16px 35px;border-radius:50px;font-weight:700;font-size:16px;
  display:inline-flex;align-items:center;gap:10px;
  box-shadow:0 10px 30px rgba(10,161,182,0.4);
  transition:.3s;border:none;cursor:pointer;
}
.btn-primary:hover{transform:translateY(-3px);box-shadow:0 15px 40px rgba(10,161,182,0.5);}
.btn-secondary{
  background:#fff;color:var(--primary);padding:16px 35px;border-radius:50px;font-weight:700;font-size:16px;
  display:inline-flex;align-items:center;gap:10px;border:2px solid var(--primary);transition:.3s;
}
.btn-secondary:hover{background:var(--primary);color:#fff;}

.hero-image{position:relative;animation:fadeIn 1.5s ease;display:flex;justify-content:center;}
.doctor-frame{
  position:relative;width:100%;max-width:450px;aspect-ratio:1/1.1;
  border-radius:50% 50% 30px 30px / 45% 45% 30px 30px;
  overflow:hidden;
  background:linear-gradient(135deg,var(--accent),var(--primary));
  box-shadow:var(--shadow-lg);
  z-index:2;
}
.doctor-frame img{
  width:100%;height:100%;object-fit:cover;object-position:center top;
  display:block;
}
.doctor-frame::after{
  content:'';position:absolute;inset:0;
  border:6px solid rgba(255,255,255,0.5);
  border-radius:inherit;pointer-events:none;
}
.hero-image::before{
  content:'';position:absolute;top:20px;right:-15px;
  width:90%;height:95%;
  border-radius:50% 50% 30px 30px / 45% 45% 30px 30px;
  background:linear-gradient(135deg,var(--primary),var(--accent));
  z-index:1;opacity:.25;
}
.deco-dots{
  position:absolute;width:120px;height:120px;
  background-image:radial-gradient(var(--primary) 2px,transparent 2px);
  background-size:18px 18px;opacity:.3;z-index:0;
}
.deco-dots.dd-1{top:-30px;right:-30px;}
.deco-dots.dd-2{bottom:-20px;left:-30px;}

.floating-card{
  position:absolute;background:#fff;padding:16px 20px;border-radius:18px;
  box-shadow:var(--shadow);display:flex;align-items:center;gap:12px;z-index:3;
  animation:float 3s ease-in-out infinite;
}
.floating-card i{font-size:26px;color:var(--primary);}
.floating-card .info strong{display:block;color:var(--dark);font-size:15px;}
.floating-card .info span{color:var(--muted);font-size:12px;}
.fc-1{top:30px;left:-20px;animation-delay:0s;}
.fc-2{bottom:60px;right:-20px;animation-delay:1.5s;}

/* Contact Bar */
.contact-bar{padding:50px 0;background:#fff;}
.contact-grid{
  display:grid;grid-template-columns:repeat(3,1fr);gap:20px;
}
.contact-card{
  background:linear-gradient(135deg,#fff,#F7FBFC);
  border:1px solid rgba(10,161,182,0.1);
  padding:25px;border-radius:20px;
  display:flex;align-items:center;gap:18px;
  transition:.3s;cursor:pointer;
}
.contact-card:hover{transform:translateY(-5px);box-shadow:var(--shadow);border-color:var(--primary);}
.contact-icon{
  width:55px;height:55px;border-radius:15px;
  background:linear-gradient(135deg,var(--primary),var(--accent));
  display:flex;align-items:center;justify-content:center;
  color:#fff;font-size:22px;flex-shrink:0;
}
.contact-info strong{display:block;color:var(--dark);font-size:14px;margin-bottom:3px;}
.contact-info a{color:var(--muted);font-size:15px;font-weight:500;}

/* Section base */
section{padding:90px 0;}
.section-head{text-align:center;max-width:650px;margin:0 auto 60px;}
.section-tag{
  display:inline-block;color:var(--primary);font-weight:700;font-size:14px;
  text-transform:uppercase;letter-spacing:2px;margin-bottom:12px;
}
.section-head h2{
  font-family:'Cairo',sans-serif;
  font-size:42px;font-weight:900;color:var(--dark);margin-bottom:15px;
}
.section-head p{color:var(--muted);font-size:17px;}

/* About */
.about{background:#fff;}
.about-grid{display:grid;grid-template-columns:1fr 1.2fr;gap:60px;align-items:center;}
.about-image{position:relative;display:flex;justify-content:center;}
.about-photo-wrap{
  position:relative;width:100%;max-width:420px;aspect-ratio:1/1.15;
  border-radius:25px;overflow:hidden;
  box-shadow:var(--shadow-lg);
  background:linear-gradient(135deg,var(--light),#fff);
}
.about-photo-wrap img{
  width:100%;height:100%;object-fit:cover;object-position:center top;
}
.about-image::before{
  content:'';position:absolute;bottom:-15px;right:-15px;
  width:100%;height:100%;max-width:420px;
  border-radius:25px;
  background:linear-gradient(135deg,var(--primary),var(--accent));
  z-index:-1;opacity:.25;
}
.about-badge{
  position:absolute;bottom:-20px;left:20px;
  background:#fff;padding:20px 25px;border-radius:18px;
  box-shadow:var(--shadow);text-align:center;z-index:2;
}
.about-badge strong{display:block;font-size:36px;color:var(--primary);font-weight:900;}
.about-badge span{color:var(--muted);font-size:14px;}
.about-content h2{
  font-family:'Cairo',sans-serif;font-size:38px;font-weight:900;
  color:var(--dark);margin-bottom:15px;
}
.about-specialty{
  background:rgba(10,161,182,0.08);color:var(--primary);font-weight:700;
  padding:12px 20px;border-radius:14px;margin-bottom:20px;display:inline-block;
  font-size:15px;line-height:1.6;border-right:4px solid var(--primary);
}
.about-content p{margin-bottom:18px;font-size:16px;}
.about-tags{display:flex;flex-wrap:wrap;gap:10px;margin:20px 0 25px;}
.about-tag{
  background:#fff;border:1px solid rgba(10,161,182,0.2);
  color:var(--primary);font-weight:600;font-size:14px;
  padding:8px 16px;border-radius:50px;
  display:inline-flex;align-items:center;gap:7px;
  transition:.3s;
}
.about-tag:hover{background:var(--primary);color:#fff;transform:translateY(-2px);}
.about-tag i{font-size:12px;}
.about-features{display:grid;grid-template-columns:1fr 1fr;gap:15px;margin-top:25px;}
.feature{display:flex;align-items:center;gap:12px;}
.feature i{
  width:38px;height:38px;border-radius:10px;
  background:rgba(10,161,182,0.1);color:var(--primary);
  display:flex;align-items:center;justify-content:center;font-size:16px;
}
.feature span{font-weight:600;color:var(--dark);}

/* Services */
.services{background:var(--bg);}
.services-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:25px;}
.service-card{
  background:#fff;padding:35px 30px;border-radius:22px;
  text-align:center;transition:.4s;border:1px solid transparent;
  position:relative;overflow:hidden;
}
.service-card::before{
  content:'';position:absolute;top:0;left:0;width:100%;height:4px;
  background:linear-gradient(90deg,var(--primary),var(--accent));
  transform:scaleX(0);transition:.4s;transform-origin:right;
}
.service-card:hover{transform:translateY(-10px);box-shadow:var(--shadow-lg);}
.service-card:hover::before{transform:scaleX(1);transform-origin:left;}
.service-icon{
  width:80px;height:80px;margin:0 auto 20px;
  background:linear-gradient(135deg,rgba(10,161,182,0.1),rgba(92,207,226,0.2));
  border-radius:25px;display:flex;align-items:center;justify-content:center;
  color:var(--primary);font-size:34px;transition:.4s;
}
.service-card:hover .service-icon{
  background:linear-gradient(135deg,var(--primary),var(--accent));color:#fff;
  transform:rotate(-5deg) scale(1.05);
}
.service-card h3{font-family:'Cairo',sans-serif;font-size:22px;color:var(--dark);margin-bottom:12px;}
.service-card p{color:var(--muted);font-size:15px;}

/* Testimonials */
.testimonials{background:#fff;}
.rating-summary{
  background:linear-gradient(135deg,var(--primary),var(--primary-dark));
  color:#fff;border-radius:25px;padding:35px;
  display:grid;grid-template-columns:auto 1fr auto;gap:30px;align-items:center;
  margin-bottom:50px;box-shadow:var(--shadow-lg);
}
.rating-big{text-align:center;}
.rating-big strong{font-size:60px;font-weight:900;line-height:1;display:block;font-family:'Cairo',sans-serif;}
.rating-big .stars-big{color:#FFC107;font-size:20px;margin-top:8px;letter-spacing:2px;}
.rating-text h3{font-family:'Cairo',sans-serif;font-size:24px;margin-bottom:8px;}
.rating-text p{opacity:.9;font-size:15px;}
.rating-stat{text-align:center;background:rgba(255,255,255,0.15);padding:18px 28px;border-radius:18px;}
.rating-stat strong{display:block;font-size:32px;font-weight:900;font-family:'Cairo',sans-serif;}
.rating-stat span{font-size:13px;opacity:.9;}

.testi-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:25px;}
.testi-card{
  background:linear-gradient(135deg,#fff,#F7FBFC);
  padding:30px;border-radius:22px;border:1px solid rgba(10,161,182,0.1);
  transition:.3s;position:relative;display:flex;flex-direction:column;
}
.testi-card:hover{transform:translateY(-5px);box-shadow:var(--shadow);}
.testi-card .quote-icon{
  position:absolute;top:20px;left:25px;font-size:36px;color:rgba(10,161,182,0.12);
}
.stars{color:#FFC107;margin-bottom:15px;font-size:16px;letter-spacing:2px;}
.testi-text{font-size:16px;color:var(--text);margin-bottom:20px;font-style:italic;flex-grow:1;}
.testi-author{
  display:flex;align-items:center;gap:13px;
  padding-top:18px;border-top:1px solid rgba(10,161,182,0.1);
}
.author-avatar{
  width:48px;height:48px;border-radius:50%;
  background:linear-gradient(135deg,var(--primary),var(--accent));
  display:flex;align-items:center;justify-content:center;
  color:#fff;font-weight:900;font-size:18px;font-family:'Cairo',sans-serif;flex-shrink:0;
}
.testi-author .info strong{display:block;color:var(--dark);font-size:15px;}
.testi-author .info span{color:var(--muted);font-size:12px;}

/* Working Hours */
/* Gallery */
.gallery{background:#fff;}
.gallery-grid{
  display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
  gap:20px;
}
.gallery-item{
  position:relative;border-radius:20px;overflow:hidden;
  box-shadow:var(--shadow);transition:.4s;cursor:pointer;
  aspect-ratio:1/1;
  background:linear-gradient(135deg,var(--primary),var(--accent));
}
.gallery-item:hover{transform:translateY(-10px);box-shadow:var(--shadow-lg);}
.gallery-item img{
  width:100%;height:100%;object-fit:cover;object-position:center;
  transition:.4s;
}
.gallery-item:hover img{transform:scale(1.1);}
.gallery-overlay{
  position:absolute;inset:0;background:rgba(15,41,64,0.7);
  display:flex;align-items:center;justify-content:center;
  opacity:0;transition:.3s;
}
.gallery-item:hover .gallery-overlay{opacity:1;}
.gallery-overlay i{font-size:40px;color:#fff;}
.gallery-large{grid-column:span 2;grid-row:span 2;}
@media (max-width:992px){
  .gallery-large{grid-column:span 1;grid-row:span 1;}
}

.hours{background:var(--bg);}
.hours-wrapper{
  background:linear-gradient(135deg,#E6F8FB 0%,#ffffff 100%);
  border-radius:30px;padding:50px;
  display:grid;grid-template-columns:1fr 1.3fr;gap:50px;align-items:center;
  position:relative;overflow:hidden;
  box-shadow:var(--shadow);
}
.hours-wrapper::before{
  content:'';position:absolute;top:-80px;left:-80px;
  width:250px;height:250px;border-radius:50%;
  background:radial-gradient(circle,rgba(10,161,182,0.15),transparent 70%);
}
.hours-intro{position:relative;z-index:1;}
.hours-intro .section-tag{margin-bottom:12px;}
.hours-intro h2{
  font-family:'Cairo',sans-serif;font-size:36px;font-weight:900;
  color:var(--dark);margin-bottom:15px;line-height:1.3;
}
.hours-intro p{color:var(--muted);font-size:16px;margin-bottom:25px;}
.hours-icon-big{
  width:80px;height:80px;border-radius:20px;
  background:linear-gradient(135deg,var(--primary),var(--accent));
  display:flex;align-items:center;justify-content:center;
  color:#fff;font-size:36px;margin-bottom:25px;
  box-shadow:0 15px 35px rgba(10,161,182,0.35);
}
.hours-list{display:flex;flex-direction:column;gap:12px;position:relative;z-index:1;}
.hours-item{
  background:#fff;border-radius:14px;padding:18px 22px;
  display:flex;justify-content:space-between;align-items:center;
  border-right:4px solid var(--primary);transition:.3s;
  box-shadow:0 5px 20px rgba(10,161,182,0.06);
}
.hours-item:hover{transform:translateX(-5px);box-shadow:var(--shadow);}
.hours-item.closed{border-right-color:#E53E3E;opacity:.85;}
.hours-item.closed .time{color:#E53E3E;}
.day{display:flex;align-items:center;gap:12px;font-weight:700;color:var(--dark);font-size:16px;}
.day i{color:var(--primary);font-size:18px;}
.hours-item.closed .day i{color:#E53E3E;}
.time{color:var(--primary);font-weight:700;font-size:15px;background:rgba(10,161,182,0.08);padding:6px 14px;border-radius:30px;}
.hours-item.closed .time{background:rgba(229,62,62,0.08);}

/* Location */
.location{background:#fff;}
.loc-grid{display:grid;grid-template-columns:1fr 1.3fr;gap:40px;align-items:stretch;}
.loc-info{
  background:linear-gradient(135deg,var(--primary),var(--primary-dark));
  color:#fff;padding:45px;border-radius:25px;display:flex;flex-direction:column;justify-content:center;
}
.loc-info h3{font-family:'Cairo',sans-serif;font-size:30px;margin-bottom:20px;}
.loc-info p{margin-bottom:25px;opacity:.95;font-size:17px;}
.loc-detail{display:flex;align-items:flex-start;gap:15px;margin-bottom:18px;}
.loc-detail i{
  width:42px;height:42px;border-radius:12px;
  background:rgba(255,255,255,0.2);display:flex;align-items:center;justify-content:center;
  font-size:18px;flex-shrink:0;
}
.loc-detail strong{display:block;margin-bottom:3px;font-size:15px;}
.loc-detail span{opacity:.9;font-size:14px;}
.btn-directions{
  background:#fff;color:var(--primary);padding:14px 30px;border-radius:50px;
  display:inline-flex;align-items:center;gap:10px;font-weight:700;
  margin-top:15px;align-self:flex-start;transition:.3s;
}
.btn-directions:hover{transform:translateY(-3px);box-shadow:0 10px 25px rgba(0,0,0,0.2);}
.loc-map{border-radius:25px;overflow:hidden;box-shadow:var(--shadow);min-height:400px;}
.loc-map iframe{width:100%;height:100%;border:0;display:block;}

/* Footer */
footer{background:var(--dark);color:#fff;padding:70px 0 25px;}
.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1.2fr;gap:40px;margin-bottom:50px;}
.footer-col h4{font-family:'Cairo',sans-serif;font-size:18px;margin-bottom:20px;color:#fff;}
.footer-col p{color:rgba(255,255,255,0.7);font-size:15px;margin-bottom:20px;}
.footer-logo{font-size:26px;font-weight:900;color:#fff;display:flex;align-items:center;gap:10px;margin-bottom:18px;}
.footer-logo i{color:var(--accent);}
.footer-col ul{list-style:none;}
.footer-col ul li{margin-bottom:12px;}
.footer-col ul a{color:rgba(255,255,255,0.7);transition:.3s;font-size:15px;}
.footer-col ul a:hover{color:var(--accent);padding-right:5px;}
.social-links{display:flex;gap:12px;margin-top:15px;}
.social-links a{
  width:42px;height:42px;border-radius:12px;
  background:rgba(255,255,255,0.1);display:flex;align-items:center;justify-content:center;
  color:#fff;transition:.3s;
}
.social-links a:hover{background:var(--primary);transform:translateY(-3px);}
.footer-contact li{display:flex;align-items:center;gap:10px;color:rgba(255,255,255,0.7);font-size:14px;}
.footer-contact li i{color:var(--accent);}
.copyright{text-align:center;padding-top:25px;border-top:1px solid rgba(255,255,255,0.1);color:rgba(255,255,255,0.6);font-size:14px;}
.copyright a{color:var(--accent);}

/* WhatsApp Float */
.whatsapp-float{
  position:fixed;bottom:25px;left:25px;
  width:60px;height:60px;background:#25D366;color:#fff;
  border-radius:50%;display:flex;align-items:center;justify-content:center;
  font-size:30px;box-shadow:0 10px 30px rgba(37,211,102,0.5);
  z-index:999;transition:.3s;animation:pulse 2s infinite;
}
.whatsapp-float:hover{transform:scale(1.1);}

/* AI Chat Assistant */
.chat-widget{
  position:fixed;bottom:100px;right:25px;
  z-index:998;display:flex;flex-direction:column;
  gap:15px;
}
.chat-toggle{
  width:60px;height:60px;background:linear-gradient(135deg,var(--primary),var(--primary-dark));
  color:#fff;border:none;border-radius:50%;font-size:24px;cursor:pointer;
  box-shadow:0 10px 30px rgba(10,161,182,0.4);transition:.3s;
  display:flex;align-items:center;justify-content:center;
}
.chat-toggle:hover{transform:scale(1.1);box-shadow:0 15px 40px rgba(10,161,182,0.6);}
.chat-window{
  position:fixed;bottom:100px;right:25px;width:380px;height:600px;
  background:#fff;border-radius:20px;box-shadow:0 20px 60px rgba(0,0,0,0.3);
  display:flex;flex-direction:column;opacity:0;transform:scale(0.8);
  transition:.3s;pointer-events:none;z-index:999;
}
.chat-window.active{opacity:1;transform:scale(1);pointer-events:all;}
.chat-header{
  background:linear-gradient(135deg,var(--primary),var(--primary-dark));
  color:#fff;padding:20px;border-radius:20px 20px 0 0;
  display:flex;justify-content:space-between;align-items:center;
}
.chat-header h3{font-family:'Cairo',sans-serif;font-size:18px;margin:0;}
.chat-header small{opacity:.8;font-size:12px;display:block;}
.chat-close{
  background:none;border:none;color:#fff;font-size:20px;cursor:pointer;
  transition:.3s;
}
.chat-close:hover{transform:rotate(90deg);}
.chat-messages{
  flex:1;overflow-y:auto;padding:20px;display:flex;flex-direction:column;
  gap:12px;
}
.message{
  display:flex;align-items:flex-end;gap:8px;margin-bottom:12px;
  animation:slideIn .3s ease;
}
.message.user{justify-content:flex-end;}
.message.bot .avatar{
  width:32px;height:32px;border-radius:50%;
  background:linear-gradient(135deg,var(--primary),var(--accent));
  display:flex;align-items:center;justify-content:center;
  color:#fff;font-size:16px;flex-shrink:0;
}
.message-text{
  max-width:280px;padding:12px 16px;border-radius:16px;
  font-size:14px;line-height:1.4;word-wrap:break-word;
}
.message.bot .message-text{
  background:var(--light);color:var(--text);border-radius:16px 16px 16px 0;
}
.message.user .message-text{
  background:var(--primary);color:#fff;border-radius:16px 16px 0 16px;
}
.chat-input-area{
  padding:15px;border-top:1px solid rgba(10,161,182,0.1);
  display:flex;gap:10px;
}
.chat-input{
  flex:1;border:1px solid rgba(10,161,182,0.2);border-radius:25px;
  padding:10px 16px;font-size:14px;font-family:'Tajawal',sans-serif;
  outline:none;transition:.3s;
}
.chat-input:focus{border-color:var(--primary);background:var(--light);}
.chat-send{
  background:var(--primary);color:#fff;border:none;border-radius:50%;
  width:40px;height:40px;display:flex;align-items:center;justify-content:center;
  cursor:pointer;font-size:18px;transition:.3s;
}
.chat-send:hover{background:var(--primary-dark);transform:scale(1.05);}
@keyframes slideIn{from{opacity:0;transform:translateY(10px);}to{opacity:1;transform:translateY(0);}}
@media (max-width:640px){
  .chat-window{width:calc(100vw - 40px);right:20px;left:20px;height:500px;}
  .message-text{max-width:200px;}
}

/* Animations */
@keyframes fadeUp{from{opacity:0;transform:translateY(30px);}to{opacity:1;transform:translateY(0);}}
@keyframes fadeIn{from{opacity:0;}to{opacity:1;}}
@keyframes float{0%,100%{transform:translateY(0);}50%{transform:translateY(-15px);}}
